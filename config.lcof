local default_tags = ["public", "v1"]
env APP_PORT = $env:LUACOF_APP_PORT ?? "8080"

defaults service {
    enabled = true
    server {
        host = "127.0.0.1"
        timeout = 30
    }
}

block application extends service {
    server {
        port = $env:APP_PORT
        tags = $var:default_tags
    }
}
