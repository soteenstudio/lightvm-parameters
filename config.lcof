block vm_config {
    name = "KopiVM-Core"
    version = "2.1.0"
    debug = $env:LIGHTVM_DEBUG ?? false
    
    # Ambil env dari sistem operasi host
    host_ip = $env:VM_HOST ?? "127.0.0.1"
    log_prefix = $env:LOG_PREFIX or "lightvm"
    
    cluster {
        nodes = 4
        region = "ap-southeast-1"
        secret_token = @"secret_" + ($env:NODE_ENV ?? "development")
    }
}
