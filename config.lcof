interface Server {
    host: string
    port: number
    tags: string[]
    timeout: number
}

interface Application {
    enabled: boolean
    server: Server
}

local default_tags: string[] = ["public", "v1"]
env APP_PORT: number = $env:LUACOF_APP_PORT ?? "8080"

defaults service {
    enabled = true
    server {
        host = "127.0.0.1"
        timeout = 30
    }
}

block application: Application extends service {
    server {
        port = $env:APP_PORT
        tags = $var:default_tags
    }
}
